# Postgres via Supabase pooler, transaction mode (port 6543). Locally: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# On Vercel, leave unset: the Supabase integration's POSTGRES_URL is used instead.
DATABASE_URL=
# Supabase project URL. Locally: http://127.0.0.1:54321
SUPABASE_URL=
# Publishable key, used for session handling via @supabase/ssr
SUPABASE_PUBLISHABLE_KEY=
# Secret key for the Auth admin API (server only)
SUPABASE_SECRET_KEY=
# Resend API key for notification emails (optional locally: emails are logged to the console)
RESEND_API_KEY=
# Sender address, e.g. Kurseinteilung <noreply@example.org>
EMAIL_FROM=
# Public base URL used in email links, e.g. http://localhost:3000
APP_URL=
# Comma-separated bootstrap admin emails
ADMIN_EMAILS=
# Protects /api/keepalive (Vercel Cron sends it as Bearer token)
CRON_SECRET=
# Demo instance only: "true" turns off the login (anyone can be anyone), sends no emails
# and resets all data daily. NEVER set this on a deployment with real data.
DEMO_MODE=
